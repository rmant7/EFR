---
pagination:
  data: languages
  size: 1
  alias: lang
layout: base.njk
---
<div class="app-shell" id="top">
  {% organizationSchema %}
  {% faqSchema i18n[lang].faq.items %}
  <section class="hero" style="border-top:0; padding-top:clamp(20px,4vw,40px);">
    <div>
      <p class="eyebrow">{{ i18n[lang].hero.eyebrow }}</p>
      <h1 class="hero-title">{{ i18n[lang].hero.title | safe }}</h1>
      <p class="hero-copy">{{ i18n[lang].hero.subtitle }}</p>
      <div class="hero-actions">
        <a class="button accent" href="/calc.html?lang={{ lang }}">
          <span>{{ i18n[lang].hero.ctaPrimary }}</span>
          <svg class="flip" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
        <a class="button ghost" href="#book">{{ i18n[lang].hero.ctaSecondary }}</a>
      </div>
      <p class="time-note" style="margin-top:16px;">{{ i18n[lang].hero.note }}</p>
    </div>
    <div class="hero-object" aria-hidden="true">
      <div class="orbit one"></div><div class="orbit two"></div>
      <div class="drift-card">
        <div class="drift-label">{{ i18n[lang].hero.cardLabel }}</div>
        <div class="drift-caption">{{ i18n[lang].hero.cardCaption }}</div>
      </div>
    </div>
  </section>
</div>

<section id="about">
  <div class="app-shell">
    <div class="section-head">
      <p class="eyebrow">{{ i18n[lang].about.eyebrow }}</p>
      <h2 class="section-title">{{ i18n[lang].about.title }}</h2>
    </div>
    <p style="max-width:760px;margin:-14px 0 32px;padding:18px 22px;border-inline-start:3px solid var(--accent);background:var(--accent-soft);border-radius:0 12px 12px 0;font-weight:600;">{{ i18n[lang].about.definition }}</p>
    <div class="about-grid">
      <div class="about-copy">
        <p>{{ i18n[lang].about.p1 }}</p>
        <p>{{ i18n[lang].about.p2 }}</p>
        <p>{{ i18n[lang].about.p3 }}</p>
      </div>
      <div class="steps">
        {% for step in i18n[lang].steps %}
        <div class="step"><div class="step-mark">{{ loop.index }}</div><div><h3>{{ step.title }}</h3><p>{{ step.body }}</p></div></div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section id="roman">
  <div class="app-shell">
    <div class="section-head">
      <p class="eyebrow">{{ i18n[lang].roman.eyebrow }}</p>
      <h2 class="section-title">{{ i18n[lang].roman.title }}</h2>
    </div>
    <div class="about-copy" style="max-width:760px;">
      <p><a href="https://www.linkedin.com/in/roman-mantelmakher/" target="_blank" rel="noopener" style="font-weight:700;color:var(--accent);text-decoration:none;">Roman Mantelmakher</a></p>
      <p>{{ i18n[lang].roman.p1 }}</p>
      <p>{{ i18n[lang].roman.p2 }}</p>
      <p>{{ i18n[lang].roman.p3 }}</p>
      <p>{{ i18n[lang].roman.p4 }}</p>
    </div>
  </div>
</section>

<section id="testimonials">
  <div class="app-shell">
    <div class="section-head">
      <p class="eyebrow">{{ i18n[lang].testimonials.eyebrow }}</p>
      <h2 class="section-title">{{ i18n[lang].testimonials.title }}</h2>
    </div>
    <div class="testi-grid">
      {% for item in testimonials[lang] %}
      <div class="testi-card">
        <p class="testi-quote">{{ item.quote }}</p>
        <div class="testi-name">{{ item.name }}</div>
        {% if item.src %}
        <div class="testi-note">
          {% if item.srcType == "li" %}{{ i18n[lang].testimonials.sourceLi }}{% else %}{{ i18n[lang].testimonials.sourceRu }}{% endif %}
          <a href="{{ item.src }}" target="_blank" rel="noopener">{{ item.srcLabel }}</a>.
        </div>
        {% endif %}
        {% if item.videoUrl %}
        <div class="testi-note"><a href="{{ item.videoUrl }}" target="_blank" rel="noopener">{{ i18n[lang].testimonials.watchVideo }}</a></div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    <p class="testi-more">{{ i18n[lang].testimonials.more | safe }}</p>
  </div>
</section>

<section id="articles">
  <div class="app-shell">
    <div class="section-head">
      <p class="eyebrow">{{ i18n[lang].articles.eyebrow }}</p>
      <h2 class="section-title">{{ i18n[lang].articles.title }}</h2>
      <p class="section-copy">{{ i18n[lang].articles.subtitle }}</p>
    </div>
    <div class="articles-list">
      {% for article in collections.articlesByLang[lang] %}
      <a href="{{ article.url }}" class="article-post" style="display:block;text-decoration:none;color:inherit;padding:26px 28px;">
        <h3>{{ article.data.title }}</h3>
        <p style="color:var(--muted);margin:8px 0 0;">{{ article.data.excerpt }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section id="book">
  <div class="app-shell">
    <div class="cta-panel">
      <div>
        <h2>{{ i18n[lang].cta.title }}</h2>
        <p>{{ i18n[lang].cta.subtitle }}</p>
      </div>
      <div class="cta-actions">
        <a class="button accent" href="https://calendly.com/roman-mantelmakher/intro-call" target="_blank" rel="noopener">{{ i18n[lang].cta.button }}</a>
        <a class="button ghost" href="/calc.html?lang={{ lang }}">{{ i18n[lang].cta.buttonSecondary }}</a>
        <p class="cta-note">{{ i18n[lang].cta.note }}</p>
      </div>
    </div>
  </div>
</section>

<section id="faq">
  <div class="app-shell">
    <div class="section-head">
      <p class="eyebrow">{{ i18n[lang].faq.eyebrow }}</p>
      <h2 class="section-title">{{ i18n[lang].faq.title }}</h2>
    </div>
    <div class="faq-list">
      {% for item in i18n[lang].faq.items %}
      <details class="faq-item"><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>
      {% endfor %}
    </div>
  </div>
</section>
