---
layout: base.njk
ogType: article
---
<div class="app-shell">
  {% articleSchema { title: title, description: excerpt, isoDate: date | isoDate, url: "https://emotions.help" + page.url, lang: lang } %}
  <article style="max-width:760px;margin:40px auto;">
    <p class="eyebrow">{{ i18n[lang].articles.eyebrow }}</p>
    <h1 class="hero-title" style="font-size:clamp(2rem,4.5vw,3.2rem);">{{ title }}</h1>
    <p style="color:var(--muted);margin-bottom:32px;">{{ date | readableDate(lang) }}</p>
    <div class="about-copy" style="white-space:pre-line;">
      {{ content | safe }}
    </div>
    <p style="margin-top:40px;">
      <a class="button ghost" href="{{ site.homeUrl[lang] }}#articles">{{ i18n[lang].nav.articles }}</a>
    </p>
  </article>
</div>
